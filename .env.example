# Để trống khi chạy Vite dev: /api được proxy tới backend local bên dưới.
# Khi deploy frontend riêng, đặt URL public của API nếu reverse proxy không xử lý /api.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# Cơ sở mặc định dùng cho trang lễ tân và kiosk.
VITE_CLINIC_LOCATION_ID=

# Có thể ghi đè cấu hình riêng cho thiết bị kiosk.
# Không đặt device id/secret ở đây — bất kỳ biến VITE_ nào cũng bị Vite nhúng
# thẳng vào bundle công khai, ai xem source cũng đọc được. Mỗi kiosk tự cấp
# khóa riêng qua đăng nhập lễ tân một lần (xem KioskCheckIn.tsx), lưu trong
# localStorage của chính máy đó.
VITE_KIOSK_CLINIC_LOCATION_ID=

# Chỉ cần khi backend yêu cầu gắn bệnh nhân trực tiếp trong payload check-in.
VITE_KIOSK_PATIENT_ID=

# DermaTimeline — tắt toàn bộ module mà không ảnh hưởng Bệnh án trọn đời.
VITE_DERMA_TIMELINE_ENABLED=true

# Derived assets có thể tắt riêng khi backend chưa cung cấp.
VITE_DERMA_TIMELINE_HEATMAP_ENABLED=true
VITE_DERMA_TIMELINE_CLINICIAN_REVIEW_ENABLED=true
